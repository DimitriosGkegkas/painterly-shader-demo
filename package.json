{
  "name": "shader-demo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "yarn build:packages && vite build",
    "preview": "vite preview",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\" \"packages/*/src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.{js,jsx,ts,tsx}\" \"packages/*/src/**/*.ts\" --fix",
    "typecheck": "yarn workspace @dimitrisgkegkas/postprocessing typecheck && yarn workspace @dimitrisgkegkas/fiber-material typecheck && tsc --noEmit",
    "test:rendering": "node scripts/check-rendering.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md}\" \"packages/*/src/**/*.ts\" \"packages/*/*.md\" --config ./.prettierrc.json",
    "build:packages": "yarn workspace @dimitrisgkegkas/postprocessing build && yarn workspace @dimitrisgkegkas/fiber-material build",
    "dev:packages": "node scripts/watch-packages.mjs",
    "test:packages": "node scripts/check-packages.mjs",
    "pack:packages": "yarn build:packages && node scripts/pack-packages.mjs",
    "test": "yarn build:packages && yarn test:rendering && yarn test:packages",
    "ci": "yarn lint && yarn typecheck && yarn test && vite build"
  },
  "dependencies": {
    "@react-three/drei": "^9.114.0",
    "@react-three/fiber": "^8.17.14",
    "leva": "^0.9.35",
    "postprocessing": "6.37.1",
    "r3f-perf": "^7.2.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "three": "^0.174.0",
    "three-stdlib": "^2.33.0",
    "@dimitrisgkegkas/postprocessing": "0.1.0",
    "@dimitrisgkegkas/fiber-material": "0.1.0"
  },
  "devDependencies": {
    "@react-three/eslint-plugin": "^0.1.1",
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.2.25",
    "@types/three": "0.169.0",
    "@typescript-eslint/eslint-plugin": "^8.7.0",
    "@typescript-eslint/parser": "^8.7.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^9.11.1",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "globals": "^15.9.0",
    "prettier": "^3.3.3",
    "typescript": "5.6.2",
    "vite": "^5.4.8",
    "vite-plugin-glsl": "^1.3.1"
  },
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "yarn@1.22.22"
}
