{
  "compilerOptions": {
    "target": "ES2020",
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@dimitrisgkegkas/postprocessing": [
        "packages/postprocessing/src/index.ts"
      ],
      "@dimitrisgkegkas/fiber-material": [
        "packages/fiber-material/src/index.ts"
      ]
    },
    "allowJs": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "vite/client"
    ]
  },
  "include": [
    "src/**/*"
  ]
}
